diff --git a/shots.mjs b/shots.mjs
new file mode 100644
index 0000000..a62f008
--- /dev/null
+++ b/shots.mjs
@@ -0,0 +1,29 @@
+import { chromium } from 'playwright';
+const b = await chromium.launch({ executablePath: '/opt/pw-browsers/chromium-1194/chrome-linux/chrome' });
+const B = 'http://localhost:3124';
+async function grab(name, path, w, h) {
+  const p = await b.newPage({ viewport: { width: w, height: h }, deviceScaleFactor: 2 });
+  await p.goto(B + path, { waitUntil: 'networkidle' });
+  const img = await p.$('img[alt*="Jerrell"]');
+  await img.scrollIntoViewIfNeeded();
+  await p.waitForFunction(() => {
+    const i = [...document.querySelectorAll('img')].find(x => x.alt.includes('Jerrell'));
+    return i && i.complete && i.naturalWidth > 0;
+  }, null, { timeout: 15000 });
+  const info = await p.evaluate(() => {
+    const i = [...document.querySelectorAll('img')].find(x => x.alt.includes('Jerrell'));
+    const r = i.getBoundingClientRect();
+    const cs = getComputedStyle(i);
+    i.closest('section').setAttribute('data-shot', 'yes');
+    const c = [...document.querySelectorAll('div')].find(d => /By using this website/.test(d.textContent) && d.className.includes('fixed'));
+    if (c) c.remove();
+    return { rendered: Math.round(r.width) + 'x' + Math.round(r.height), mask: (cs.maskImage || cs.webkitMaskImage || 'none').slice(0, 60) };
+  });
+  console.log(name.padEnd(22), JSON.stringify(info));
+  const sec = await p.$('[data-shot="yes"]');
+  await sec.screenshot({ path: `/tmp/${name}.png` });
+  await p.close();
+}
+await grab('fade-home-1440', '/', 1440, 1000);
+await grab('fade-about-1440', '/about', 1440, 1100);
+await b.close();
