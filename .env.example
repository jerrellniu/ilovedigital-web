# MailerLite — form submissions (audit, contact, newsletter)
# Create a key in MailerLite: Integrations → API. Never commit the real .env.
MAILERLITE_API_KEY=

# MailerLite group IDs. Each group triggers its automation
# (internal notification + auto-reply). Create the groups in MailerLite
# and paste their IDs here.
ML_GROUP_NEWSLETTER=
ML_GROUP_AUDIT=
ML_GROUP_CONTACT=

# Cloudflare Turnstile — bot protection on all four forms.
# Create a widget at dash.cloudflare.com -> Turnstile. Use the "Managed" mode.
# Leaving these unset disables Turnstile on both the client and the server, so the
# forms keep working; the origin, shape and content checks still apply.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
