# MailerLite — form submissions (audit, contact, newsletter)
# Create a key in MailerLite: Integrations → API. Never commit the real .env.
MAILERLITE_API_KEY=

# MailerLite group IDs. Each group triggers its automation
# (internal notification + auto-reply). Create the groups in MailerLite
# and paste their IDs here.
ML_GROUP_NEWSLETTER=
ML_GROUP_AUDIT=
ML_GROUP_CONTACT=

# Cloudflare Turnstile — bot protection on all four forms.
# Create a widget at dash.cloudflare.com -> Turnstile. Use the "Managed" mode.
# Leaving these unset disables Turnstile on both the client and the server, so the
# forms keep working; the origin, shape and content checks still apply.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Instant website audit (/audit, POST /api/audit)
# Claude writes the summary and 3-month plan from the measured findings. Without a key
# the report still runs, with a rules-based plan. AUDIT_MODEL is optional.
ANTHROPIC_API_KEY=
AUDIT_MODEL=claude-sonnet-5-5
# Google PageSpeed Insights key. Without it Google's shared quota usually returns 429
# and speed is reported as "not checked". Free: Google Cloud -> PageSpeed Insights API.
PAGESPEED_API_KEY=
# Optional MailerLite group for instant-audit leads. Keep it separate from
# ML_GROUP_AUDIT, whose auto-reply promises the old manual Loom audit.
ML_GROUP_INSTANT_AUDIT=
# Report emails go out over Google Workspace SMTP (shared with form notifications).
# SMTP_PASSWORD is a Google app password. NOTIFY_TO gets the internal copy.
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_TO=
